# Root .gitignore for SmartGuard_Unified

# =========================
# Visual Studio / .NET Core
# =========================
**/bin/
**/obj/
**/.vs/
**/*.user
**/*.userosscache
**/*.suo
**/TestResults/
[Dd]ebug/
[Rr]elease/
*.trx
*.DotSettings.user

# =========================
# ASP.NET Core Secrets & Logs
# =========================
appsettings.*.local.json
**/wwwroot/evidence/*
!**/wwwroot/evidence/.gitkeep
*.log
logs/

# =========================
# Flutter / Dart
# =========================
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/**/GeneratedPluginRegistrant.java
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/coverage/

# =========================
# OS / IDE Artifacts
# =========================
.DS_Store
Thumbs.db
*.swp
*.bak
.idea/
*.iml
